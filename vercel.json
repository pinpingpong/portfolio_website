{
  "version": 2,
  "builds": [
    { "src": "api/chat.js", "use": "@vercel/node" },
    { "src": "public/styles.css", "use": "@vercel/static" },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { 
      "src": "/api/chat", 
      "dest": "/api/chat.js" 
    },
    { 
      "src": "/styles.css", 
      "dest": "/public/styles.css" 
    },
    { 
      "src": "/(.*)", 
      "dest": "/index.html" 
    }
  ]
}